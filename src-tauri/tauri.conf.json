{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primordial Task",
  "version": "0.1.0",
  "identifier": "com.primordial.task",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Primordial Task",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
